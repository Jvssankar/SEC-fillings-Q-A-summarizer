# Copy this file to ".env" and fill in the two required values.

# REQUIRED - your Gemini API key (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# REQUIRED - SEC EDGAR asks every program to identify its owner.
# Use your real name and a real email address.
SEC_USER_AGENT="Your Name your.email@gmail.com"

# Optional settings (defaults shown)
# TICKERS=AAPL,MSFT,TSLA
# FILINGS_10K=2
# FILINGS_10Q=2
# GEMINI_MODEL=gemini-3.8-flash
# TOP_K=6
# MAX_CONTEXT_CHARS=12000
